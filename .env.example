# Variables de entorno para el proyecto
# Copia este archivo como .env y reemplaza los valores

# URL de tu proyecto en Supabase
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave publica (anon/publishable) de Supabase - segura para usar en el frontend
PUBLIC_SUPABASE_ANON_KEY=tu-clave-publica-aqui
