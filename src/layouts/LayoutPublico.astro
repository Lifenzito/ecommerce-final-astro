---
// Layout principal para las paginas publicas de la tienda
// Incluye la barra de navegacion y el pie de pagina

interface Props {
  titulo: string;
}

const { titulo } = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Tienda en linea - Proyecto final universitario" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{titulo} | TechStore</title>
  </head>
  <body class="bg-gray-950 text-gray-100 min-h-screen flex flex-col">
    <!-- Barra de navegacion -->
    <nav class="bg-gray-900 border-b border-gray-800 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <!-- Logo -->
          <a href="/" class="text-xl font-bold text-primary-400 hover:text-primary-300 transition-colors">
            TechStore
          </a>

          <!-- Enlaces de navegacion -->
          <div class="flex items-center gap-6">
            <a href="/" class="text-gray-300 hover:text-white transition-colors text-sm">
              Catalogo
            </a>
            <a
              href="/admin"
              class="text-gray-400 hover:text-gray-200 transition-colors text-sm"
            >
              Admin
            </a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Contenido principal -->
    <main class="flex-1 max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>

    <!-- Pie de pagina -->
    <footer class="bg-gray-900 border-t border-gray-800 py-6 mt-auto">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-gray-500 text-sm">
        <p>TechStore - Proyecto Final Universitario</p>
        <p class="mt-1">Astro + Supabase + TailwindCSS + Cloudflare</p>
      </div>
    </footer>
  </body>
</html>
