---
// Componente que muestra la tarjeta de un producto en el catalogo
// Recibe los datos del producto como props

interface Props {
  id: string;
  nombre: string;
  precio: number;
  imagen: string;
  categoria: string;
}

const { id, nombre, precio, imagen, categoria } = Astro.props;

// Formateamos el precio en pesos colombianos, sin decimales
const precioFormateado = new Intl.NumberFormat("es-CO", {
  style: "currency",
  currency: "COP",
  maximumFractionDigits: 0,
}).format(precio);
---

<a
  href={`/producto/${id}`}
  class="group bg-gray-900 rounded-lg border border-gray-800 overflow-hidden hover:border-primary-500 transition-all duration-300 hover:shadow-lg hover:shadow-primary-500/10"
>
  <!-- Imagen del producto -->
  <div class="aspect-square overflow-hidden bg-gray-800">
    {
      imagen ? (
        <img
          src={imagen}
          alt={nombre}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
          loading="lazy"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center text-gray-600">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
      )
    }
  </div>

  <!-- Informacion del producto -->
  <div class="p-4">
    <span class="text-xs text-primary-400 uppercase tracking-wider">{categoria}</span>
    <h3 class="text-lg font-semibold text-gray-100 mt-1 group-hover:text-primary-300 transition-colors line-clamp-2">
      {nombre}
    </h3>
    <p class="text-xl font-bold text-primary-400 mt-2">{precioFormateado}</p>
  </div>
</a>
