---
// Pagina de detalle de un producto
// Se renderiza con SSR usando el ID de la URL
// Solo muestra productos activos

import LayoutPublico from "../../layouts/LayoutPublico.astro";
import { supabase } from "../../lib/supabase";

// Obtenemos el ID del producto desde los parametros de la URL
const { id } = Astro.params;

// Consultamos el producto en Supabase
const { data: producto, error } = await supabase
  .from("products")
  .select("*")
  .eq("id", id)
  .eq("is_active", true)
  .single();

// Si no existe o no esta activo, mostramos 404
if (error || !producto) {
  return Astro.redirect("/");
}

// Formateamos el precio en pesos colombianos, sin decimales
const precioFormateado = new Intl.NumberFormat("es-CO", {
  style: "currency",
  currency: "COP",
  maximumFractionDigits: 0,
}).format(producto.price);

// Formateamos la fecha de creacion
const fechaCreacion = new Date(producto.created_at).toLocaleDateString("es-ES", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<LayoutPublico titulo={producto.name}>
  <!-- Enlace para volver al catalogo -->
  <a
    href="/"
    class="inline-flex items-center gap-2 text-primary-400 hover:text-primary-300 transition-colors mb-6"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
    </svg>
    Volver al catalogo
  </a>

  <!-- Contenido del producto -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
    <!-- Imagen del producto -->
    <div class="aspect-square bg-gray-900 rounded-lg border border-gray-800 overflow-hidden">
      {
        producto.image_url ? (
          <img
            src={producto.image_url}
            alt={producto.name}
            class="w-full h-full object-cover"
          />
        ) : (
          <div class="w-full h-full flex items-center justify-center text-gray-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-24 h-24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
        )
      }
    </div>

    <!-- Informacion del producto -->
    <div class="space-y-6">
      <div>
        <span class="text-sm text-primary-400 uppercase tracking-wider">{producto.category}</span>
        <h1 class="text-3xl font-bold mt-2">{producto.name}</h1>
      </div>

      <p class="text-4xl font-bold text-primary-400">{precioFormateado}</p>

      {
        producto.description && (
          <div>
            <h2 class="text-lg font-semibold mb-2">Descripcion</h2>
            <p class="text-gray-400 leading-relaxed">{producto.description}</p>
          </div>
        )
      }

      <!-- Detalles adicionales -->
      <div class="border-t border-gray-800 pt-6 space-y-3">
        <div class="flex items-center justify-between text-sm">
          <span class="text-gray-400">Categoria</span>
          <span class="text-gray-200">{producto.category}</span>
        </div>
        <div class="flex items-center justify-between text-sm">
          <span class="text-gray-400">Disponible desde</span>
          <span class="text-gray-200">{fechaCreacion}</span>
        </div>
        <div class="flex items-center justify-between text-sm">
          <span class="text-gray-400">Estado</span>
          <span class="text-green-400">Disponible</span>
        </div>
      </div>
    </div>
  </div>
</LayoutPublico>
